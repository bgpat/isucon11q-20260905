{
  "description": "目標Issue未達時にCodexのターン終了を継続要求へ変換する。",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/goal-score-stop.sh\"",
            "timeout": 30,
            "statusMessage": "Checking goal score before stopping"
          }
        ]
      }
    ]
  }
}
