# 提出用に近い計測では 0。調査時は 1（#12）。
ENABLE_PPROF=0
# GET /api/trend のスパンを OTLP で Tempo へ送る。ENABLE_TRACING=0 で無効化（#12, #366）。
# 各サーバーのローカル distributor へ送る。make monitoring 後にアプリを再起動する。
ENABLE_TRACING=0
# Echo アクセスログは既定で無効。調査時だけ 1 にする（#168）。
# ENABLE_ACCESS_LOG=1
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
