[Unit]
Description=isucondition.go
After=network.target mysql.service valkey.service cloud-config.service

[Service]
WorkingDirectory=/home/isucon/webapp/go
EnvironmentFile=/home/isucon/env.sh
EnvironmentFile=-/etc/isucondition-observability.env

User=isucon
Group=www-data
RuntimeDirectory=isucondition
RuntimeDirectoryMode=0750
Environment=SERVER_UNIX_SOCKET=/run/isucondition/isucondition.sock
ExecStart=/home/isucon/webapp/go/isucondition

Restart   = always
Type      = simple

[Install]
WantedBy=multi-user.target
